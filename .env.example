# Used by docker-compose.yml only. Backend/worker app settings live in
# backend/.env (see backend/.env.example) -- docker-compose passes that
# file through via `env_file` and overrides just the values that need to
# be different inside the Docker network (DATABASE_URL host, UPLOAD_DIR).
#
# Copy this to .env at the repo root before running `docker compose up`.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent_platform

# Ollama running on the HOST machine (not in a container). On Linux you may
# need to run Ollama with OLLAMA_HOST=0.0.0.0 and use your host's actual
# LAN/bridge IP instead of host.docker.internal if this default doesn't
# resolve for your Docker setup.
OLLAMA_BASE_URL=http://host.docker.internal:11434
