# Copy this file to .env and adjust as needed.

APP_NAME="Aria Agent Platform"
ENVIRONMENT=development

# Origins allowed to call the ADMIN dashboard APIs (/api/admin/*).
# The public widget APIs (/api/chat, /api/session/*) are NOT restricted by
# this list -- see app/main.py for why that's safe here, and
# app/security/domains.py for the per-agent allowed_domains check that
# actually gates public widget embedding.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Postgres + pgvector. Local (non-Docker) default assumes a Postgres server
# on localhost with the "vector" extension available (see README "Local
# Postgres without Docker"). Inside docker-compose this is overridden to
# point at the "postgres" service instead.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agent_platform

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
CHAT_MODEL=qwen3:8b
LLM_REQUEST_TIMEOUT=60

# --- AI provider configuration ---
# IMPORTANT: this is only used to seed the initial default "Ollama"
# provider row on first startup (see app/seed.py::_seed_default_provider),
# so upgrading an existing installation keeps working without any admin
# action. After that, ALL model/provider configuration -- including Groq,
# OpenAI, or any other provider's API key -- is managed from the admin
# dashboard (Admin -> AI Providers), stored encrypted in the database, and
# is NOT read from environment variables. Do not put GROQ_API_KEY,
# OPENAI_API_KEY, etc. here; there is nothing that reads them.
OLLAMA_DEFAULT_BASE_URL=http://localhost:11434

# Key used to encrypt AI provider API keys at rest (reversibly). Treat like
# any other secret -- changing it makes existing encrypted provider
# credentials undecryptable, requiring them to be re-entered in the admin
# dashboard.
ENCRYPTION_KEY=CHANGE_ME

# --- Knowledge base / RAG ---
# "ollama" (default) calls a local Ollama embedding model. "deterministic"
# is a dependency-free test/offline double -- see
# app/rag/embeddings/service.py -- never use it in production.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Must match the chosen embedding model's output dimension (nomic-embed-text
# = 768). Changing this after documents are ingested requires re-ingesting
# everything (the pgvector column's dimension is fixed at table creation).
VECTOR_DIMENSION=768

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=20971520
ALLOWED_FILE_EXTENSIONS=pdf,docx,txt,csv,json,md

CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4

WORKER_COUNT=1
WORKER_POLL_INTERVAL_SECONDS=2

# Admin dashboard login (issues ADMIN_SECRET_KEY to the browser on success).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
ADMIN_SECRET_KEY=CHANGE_ME

# HMAC key used to hash public agent tokens before storing them. Rotating
# this invalidates every existing agent token.
TOKEN_HASH_SECRET=CHANGE_ME

RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_MINUTE_PER_IP=60

SEED_DEMO_DATA=true
